{
	"name": "pi-rules-md",
	"version": "0.1.0",
	"description": "Pi extension that discovers markdown rules and injects conditionally matched ones into the system prompt. Functional core, imperative shell.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"rules",
		"system-prompt"
	],
	"license": "MIT",
	"bin": {
		"pi-rules": "dist/cli.mjs"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"author": "MetalbolicX",
	"files": [
		"index.ts",
		"src",
		"shell",
		"README.md",
		"RULE-SPEC.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"lint": "oxlint",
		"typecheck": "tsc --noEmit",
		"build": "rolldown -c",
		"prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"picomatch": "^4.0.7",
		"tinyglobby": "^0.2.17",
		"typebox": "1.3.27",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@types/node": "^26.6.2",
		"@types/picomatch": "^4.0.3",
		"oxlint": "^1.85.0",
		"rolldown": "^1.2.4",
		"typescript": "~7.0.2",
		"vitest": "^5.0.1"
	}
}
