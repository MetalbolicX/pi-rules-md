{
	"name": "pi-rules-md",
	"version": "0.1.0",
	"description": "Pi extension that discovers markdown rules and injects conditionally matched ones into the system prompt. Functional core, imperative shell.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"rules",
		"system-prompt"
	],
	"license": "MIT",
	"author": "MetalbolicX",
	"files": [
		"index.ts",
		"src",
		"shell",
		"README.md",
		"RULE-SPEC.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"picomatch": "^4.0.7",
		"tinyglobby": "^0.2.17",
		"typebox": "1.3.27",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@types/node": "^26.6.2",
		"@types/picomatch": "^4.0.3",
		"typescript": "~7.0.2",
		"vitest": "^5.0.1"
	}
}
